{
  "name": "@kitepass/mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Kite Agent Passport — exposes kpass operations as tools for LLM agents",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "kitepass-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js"
  },
  "keywords": [
    "mcp",
    "kite",
    "kite-mainnet",
    "kpass",
    "agent-payment",
    "x402",
    "anthropic",
    "model-context-protocol"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "author": "Gnanam <github.com/gnanam1990>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gnanam1990/kitepass-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gnanam1990/kitepass-mcp/issues"
  },
  "homepage": "https://github.com/gnanam1990/kitepass-mcp",
  "engines": {
    "node": ">=18.0.0"
  }
}
